# swaylock-effects - Matrix theme
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: green 00ff41, yellow e5ff41, red ff4141
ring-color=00ff41ff
inside-color=0d020866
text-color=00ff41ff
key-hl-color=aaff66ff
bs-hl-color=00b32cff
ring-ver-color=00d95fff
inside-ver-color=0d020866
text-ver-color=00d95fff
ring-clear-color=e5ff41ff
inside-clear-color=0d020866
text-clear-color=e5ff41ff
caps-lock-key-hl-color=aaff66ff
caps-lock-bs-hl-color=00b32cff
ring-wrong-color=ff4141ff
inside-wrong-color=0d020866
text-wrong-color=ff4141ff
line-uses-ring
separator-color=00000000
layout-text-color=00ff41ff
