# swaylock-effects - Example theme (teal starter)
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: purple 00e5c7, pink ffd166, red ff4141
ring-color=00e5c7ff
inside-color=02100e66
text-color=00e5c7ff
key-hl-color=b3fff4ff
bs-hl-color=00997dff
ring-ver-color=00bfa5ff
inside-ver-color=02100e66
text-ver-color=00bfa5ff
ring-clear-color=ffd166ff
inside-clear-color=02100e66
text-clear-color=ffd166ff
caps-lock-key-hl-color=b3fff4ff
caps-lock-bs-hl-color=00997dff
ring-wrong-color=ff4141ff
inside-wrong-color=02100e66
text-wrong-color=ff4141ff
line-uses-ring
separator-color=00000000
layout-text-color=00e5c7ff
