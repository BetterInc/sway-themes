# swaylock-effects - Purple theme
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: purple b44dff, pink ff6ac1, red ff4141
ring-color=b44dffff
inside-color=0a041066
text-color=b44dffff
key-hl-color=d8a5ffff
bs-hl-color=9333eaff
ring-ver-color=9d5cffff
inside-ver-color=0a041066
text-ver-color=9d5cffff
ring-clear-color=ff6ac1ff
inside-clear-color=0a041066
text-clear-color=ff6ac1ff
caps-lock-key-hl-color=d8a5ffff
caps-lock-bs-hl-color=9333eaff
ring-wrong-color=ff4141ff
inside-wrong-color=0a041066
text-wrong-color=ff4141ff
line-uses-ring
separator-color=00000000
layout-text-color=b44dffff
